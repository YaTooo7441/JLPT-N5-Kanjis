const KANJI = [
  // NUMBERS
  { char:'一', meaning:'One', on:'イチ', kun:'ひと-つ', strokes:1, cat:'numbers',
    mnemonic:'A single <strong>horizontal stroke</strong> — one line, one meaning. Like a horizon stretching across the page.', 
    examples:[{jp:'一つ',rom:'hitotsu',en:'one (thing)'},{jp:'一月',rom:'ichigatsu',en:'January'}]},
  { char:'二', meaning:'Two', on:'ニ', kun:'ふた-つ', strokes:2, cat:'numbers',
    mnemonic:'<strong>Two parallel lines</strong>, like train tracks heading into the distance — two rails, two.',
    examples:[{jp:'二つ',rom:'futatsu',en:'two (things)'},{jp:'二月',rom:'nigatsu',en:'February'}]},
