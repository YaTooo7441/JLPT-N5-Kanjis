    examples:[{jp:'書く',rom:'kaku',en:'to write'},{jp:'図書館',rom:'toshokan',en:'library'}]},
  { char:'読', meaning:'Read', on:'ドク', kun:'よ-む', strokes:14, cat:'verbs',
    mnemonic:'Say (言) + sell (売): <strong>reading means selling the words</strong> back to your mind.',
    examples:[{jp:'読む',rom:'yomu',en:'to read'},{jp:'読書',rom:'dokusho',en:'reading (books)'}]},
  { char:'学', meaning:'Study / Learn', on:'ガク', kun:'まな-ぶ', strokes:8, cat:'verbs',
    mnemonic:'Hands above a child (子) — <strong>adults guiding the hands of a child</strong> as they learn.',
    examples:[{jp:'学ぶ',rom:'manabu',en:'to learn'},{jp:'学校',rom:'gakkou',en:'school'}]},
  { char:'買', meaning:'Buy', on:'バイ', kun:'か-う', strokes:12, cat:'verbs',
    mnemonic:'Net (罒) over shells (貝) — <strong>casting a net over precious shells</strong> (ancient currency) to buy things.',
    examples:[{jp:'買う',rom:'kau',en:'to buy'},{jp:'買い物',rom:'kaimono',en:'shopping'}]},
];

// Remove duplicate 食
const seen = new Set();
const KANJI_DATA = KANJI.filter(k => {
  if (seen.has(k.char + k.meaning)) return false;
  seen.add(k.char + k.meaning);
  return true;
});

// ────────────────────────────────────────────────
// STATE
// ────────────────────────────────────────────────
let mastered = new Set(JSON.parse(localStorage.getItem('mastered_kanji') || '[]'));
let currentFilter = 'all';
let currentSection = 'all';
let detailKanji = null;

// Quiz state
let qCorrect = 0, qWrong = 0, qTotal = 0, qAnswered = false;

// ────────────────────────────────────────────────
// RENDER GRID
// ────────────────────────────────────────────────
function renderGrid(list) {
  const grid = document.getElementById('kanji-grid');
  const empty = document.getElementById('empty-msg');
  grid.innerHTML = '';
  if (!list.length) { empty.style.display = 'block'; return; }
  empty.style.display = 'none';
  list.forEach(k => {
    const card = document.createElement('div');
    card.className = 'kanji-card' + (mastered.has(k.char) ? ' mastered' : '');
    card.innerHTML = `
      <div class="kc-top">
        <span class="kc-char">${k.char}</span>
        <span class="kc-stroke">${k.strokes} stroke${k.strokes > 1 ? 's' : ''}</span>
      </div>
      <div class="kc-body">
        <div class="kc-meaning">${k.meaning}</div>
        <div class="kc-reading">
          <span class="reading-tag">on: ${k.on}</span>
          <span class="reading-tag">kun: ${k.kun}</span>
        </div>
        <div class="kc-mnemonic">${k.mnemonic.replace(/<strong>/g,'').replace(/<\/strong>/g,'')}</div>
      </div>
    `;
    card.onclick = () => openDetail(k);
    grid.appendChild(card);
  });
}

function getFilteredList() {
  let list = KANJI_DATA;
  if (currentFilter === 'mastered') list = list.filter(k => mastered.has(k.char));
  else if (currentFilter !== 'all') list = list.filter(k => k.cat === currentFilter);
  const q = document.getElementById('search-input').value.trim().toLowerCase();
  if (q) list = list.filter(k => k.char.includes(q) || k.meaning.toLowerCase().includes(q) || k.on.toLowerCase().includes(q) || k.kun.toLowerCase().includes(q));
  return list;
}

function refreshGrid() { renderGrid(getFilteredList()); }

// ────────────────────────────────────────────────
// NAVIGATION
// ────────────────────────────────────────────────
function switchSection(name) {
  currentSection = name;
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.getElementById('sec-' + (name === 'quiz' ? 'quiz' : 'all')).classList.add('active');

  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById('nav-' + name);
  if (btn) btn.classList.add('active');

  if (name === 'quiz') {
    document.getElementById('section-title').textContent = '漢字クイズ';
    document.getElementById('section-desc').textContent = 'Multiple choice kanji quiz';
    document.getElementById('search-input').style.display = 'none';
    if (qTotal === 0) nextQuestion();
  } else {
    document.getElementById('search-input').style.display = '';
    currentFilter = name;
    updateTopbar();
    refreshGrid();
  }
}

function filterCategory(cat) {
  currentFilter = cat;
  currentSection = 'all';
  document.getElementById('sec-all').classList.add('active');
  document.getElementById('sec-quiz').classList.remove('active');
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById('nav-' + cat);
  if (btn) btn.classList.add('active');
  document.getElementById('search-input').style.display = '';
  updateTopbar();
  refreshGrid();
}

function updateTopbar() {
  const labels = {
    all:'All N5 Kanji', mastered:'Mastered Kanji',
    numbers:'Numbers', time:'Time & Date', people:'People',
    nature:'Nature', body:'Body Parts', place:'Places', things:'Things', verbs:'Actions & Verbs'
  };
  const counts = getFilteredList().length;
  document.getElementById('section-title').textContent = labels[currentFilter] || 'Kanji';
  document.getElementById('section-desc').textContent = `${counts} kanji · Click any card for details & mnemonic`;
}

function handleSearch() { refreshGrid(); }

// ────────────────────────────────────────────────
// DETAIL PANEL
// ────────────────────────────────────────────────
function openDetail(k) {
  detailKanji = k;
  document.getElementById('dp-char').textContent = k.char;
  document.getElementById('dp-meaning').textContent = k.meaning;
  document.getElementById('dp-strokes').textContent = `${k.strokes} strokes · ${k.cat}`;
  document.getElementById('dp-mnemonic').innerHTML = k.mnemonic;

  const readingsEl = document.getElementById('dp-readings');
  readingsEl.innerHTML = `
    <span class="pill-label">on</span>
    ${k.on.split(',').map(r => `<span class="dp-reading-pill pill-on">${r.trim()}</span>`).join('')}
    <span class="pill-label" style="margin-left:6px">kun</span>
    ${k.kun === '—' ? '<span style="color:var(--muted);font-size:12px">—</span>' : k.kun.split(',').map(r => `<span class="dp-reading-pill pill-kun">${r.trim()}</span>`).join('')}
  `;

  const exList = document.getElementById('dp-examples');
  exList.innerHTML = k.examples.map(ex => `
    <div class="example-item">
      <div class="ex-jp">${ex.jp}</div>
      <div class="ex-rom">${ex.rom}</div>
      <div class="ex-en">${ex.en}</div>
    </div>
  `).join('');

  const masterBtn = document.getElementById('dp-master-btn');
  masterBtn.textContent = mastered.has(k.char) ? 'Unmark as Mastered' : 'Mark as Mastered ✓';
  masterBtn.className = 'dp-btn ' + (mastered.has(k.char) ? 'secondary' : 'primary');

  document.getElementById('overlay').classList.add('open');
}

function closeDetail() { document.getElementById('overlay').classList.remove('open'); }
function closeOverlay(e) { if (e.target === document.getElementById('overlay')) closeDetail(); }

function toggleMaster() {
  if (!detailKanji) return;
  if (mastered.has(detailKanji.char)) mastered.delete(detailKanji.char);
  else mastered.add(detailKanji.char);
  localStorage.setItem('mastered_kanji', JSON.stringify([...mastered]));
  updateStats();
  refreshGrid();
  openDetail(detailKanji);
}

// ────────────────────────────────────────────────
// STATS
// ────────────────────────────────────────────────
function updateStats() {
  const m = mastered.size;
  const t = KANJI_DATA.length;
  document.getElementById('stat-mastered').textContent = m;
  document.getElementById('stat-total').textContent = t;
  document.getElementById('nc-mastered').textContent = m;
  document.getElementById('sidebar-prog').style.width = (m/t*100).toFixed(1) + '%';
  document.getElementById('sidebar-prog-text').textContent = `${m} / ${t} mastered`;
}

// ────────────────────────────────────────────────
// QUIZ
// ────────────────────────────────────────────────
function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }

function nextQuestion() {
  qAnswered = false;
  document.getElementById('q-feedback').textContent = '';
  document.getElementById('q-next').style.display = 'none';

  const pool = KANJI_DATA;
  const target = pool[Math.floor(Math.random() * pool.length)];
  document.getElementById('q-char').textContent = target.char;

  let opts = [target.meaning];
  while (opts.length < 4) {
    const r = pool[Math.floor(Math.random() * pool.length)].meaning;
    if (!opts.includes(r)) opts.push(r);
  }
  opts = shuffle(opts);

  const container = document.getElementById('q-opts');
  container.innerHTML = '';
  opts.forEach(opt => {
    const btn = document.createElement('button');
    btn.className = 'q-opt';
    btn.textContent = opt;
    btn.onclick = () => {
      if (qAnswered) return;
      qAnswered = true;
      qTotal++;
      container.querySelectorAll('.q-opt').forEach(b => b.disabled = true);
      if (opt === target.meaning) {
        btn.classList.add('correct');
        qCorrect++;
        document.getElementById('q-feedback').innerHTML = '<span class="feedback-correct">正解！ Correct!</span>';
      } else {
        btn.classList.add('wrong');
        container.querySelectorAll('.q-opt').forEach(b => { if (b.textContent === target.meaning) b.classList.add('correct'); });
        document.getElementById('q-feedback').innerHTML = `<span class="feedback-wrong">The answer was "${target.meaning}"</span>`;
      }
      qWrong = qTotal - qCorrect;
      document.getElementById('q-correct').textContent = qCorrect;
      document.getElementById('q-wrong').textContent = qWrong;
      document.getElementById('q-total').textContent = qTotal;
      document.getElementById('qpfill').style.width = Math.min(100, (qTotal / 20) * 100) + '%';
      document.getElementById('qpnum').textContent = `${qTotal} / 20`;
      document.getElementById('q-next').style.display = 'inline-block';
    };
    container.appendChild(btn);
  });
}

// ────────────────────────────────────────────────
// INIT
// ────────────────────────────────────────────────
updateStats();
refreshGrid();
</script>
</body>
</html>
